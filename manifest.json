{
  "manifest_version": 3,
  "name": "WWWire - Live Website Wireframes",
  "short_name": "WWWire",
  "version": "0.4.0",
  "description": "Turn any website into a lo-fi wireframe, then sketch on top of it with your own containers and text boxes.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "WWWire",
    "default_icon": {
      "16": "icons/bar16.png",
      "32": "icons/bar32.png",
      "48": "icons/bar48.png",
      "128": "icons/bar128.png"
    }
  },
  "icons": {
    "16": "icons/bar16.png",
    "32": "icons/bar32.png",
    "48": "icons/bar48.png",
    "128": "icons/bar128.png"
  },
  "commands": {
    "toggle-draft": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Toggle draft mode on/off"
    }
  }
}
