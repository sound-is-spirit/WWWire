{
  "manifest_version": 3,
  "name": "WireDrafter",
  "version": "0.3.0",
  "description": "Turn any website into an editable lo-fi wireframe. Strip the styling, sketch the structure, move and delete anything.",
  "permissions": ["storage", "activeTab", "scripting"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "WireDrafter",
    "default_icon": {
      "16": "icons/bar16.png",
      "32": "icons/bar32.png",
      "48": "icons/bar48.png",
      "128": "icons/bar128.png"
    }
  },
  "icons": {
    "16": "icons/bar16.png",
    "32": "icons/bar32.png",
    "48": "icons/bar48.png",
    "128": "icons/bar128.png"
  },
  "commands": {
    "toggle-draft": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Toggle draft mode on/off"
    }
  }
}
