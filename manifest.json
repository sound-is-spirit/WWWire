{
  "manifest_version": 3,
  "name": "GreyOut",
  "version": "2.2.0",
  "description": "Masks all on-screen text with grey blocks for safe screen sharing, demos and screenshots. Works on any page.",
  "permissions": ["storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "GreyOut",
    "default_icon": {
      "16": "icons/bar16.png",
      "32": "icons/bar32.png",
      "48": "icons/bar48.png",
      "128": "icons/bar128.png"
    }
  },
  "icons": {
    "16": "icons/bar16.png",
    "32": "icons/bar32.png",
    "48": "icons/bar48.png",
    "128": "icons/bar128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content_isolated.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "commands": {
    "toggle-anonymizer": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Toggle anonymization on/off"
    }
  }
}
